//==== module ====
{
  "id": "arr",
  "name": "Arr stack",
  "description": "A page for the *arr suite: library statistics and health of Sonarr / Radarr / Lidarr / Readarr / Prowlarr, live download status (qBittorrent, SABnzbd and the arr queues), who is logged in and watching on Plex / Jellyfin / Emby, and search + request of movies and shows into Sonarr / Radarr (with optional TMDB metadata). Uses each app's API, directly or through your saved SSH logins, and can detect services and their API keys from Docker over SSH.",
  "version": "0.2.0",
  "minApi": 7,
  "permissions": [
    "ssh",
    "data",
    "http"
  ],
  "pages": [
    {
      "id": "arr",
      "label": "*arr"
    }
  ],
  "config": [
    {
      "key": "tmdbKey",
      "label": "TMDB API key (optional)",
      "type": "password",
      "placeholder": "v3 API key or v4 read access token",
      "help": "Free from themoviedb.org (Settings > API). When set, search uses TMDB for results; without it, Sonarr and Radarr's own lookup is used."
    },
    {
      "key": "interval",
      "label": "Refresh every (seconds)",
      "type": "number",
      "default": 30,
      "help": "How often the open page refreshes services, downloads and who is watching (5 to 300)."
    }
  ]
}
