//==== module ====
{
  "id": "docker_helper",
  "name": "Docker helper",
  "description": "A Docker tab for your SSH servers: compose stacks (found by scanning for compose files and docker ps), containers, networks and volumes, live CPU / memory, start / stop / restart, a shell inside a container, a live log tail and a compose file editor. Works over your saved SSH logins through the docker CLI on the server: no socket exposed, nothing to install on the server.",
  "version": "0.2.0",
  "minApi": 7,
  "permissions": [
    "ssh",
    "sshStream",
    "data"
  ],
  "serverTabs": [
    {
      "id": "docker",
      "label": "Docker"
    }
  ],
  "config": [
    {
      "key": "scanDirs",
      "label": "Folders to scan for compose files",
      "type": "text",
      "default": "~ /opt /srv /home",
      "help": "Space separated, searched 4 levels deep. Stacks that are running are always found, whatever folder they live in. Each server can override this in its Docker tab."
    },
    {
      "key": "interval",
      "label": "Refresh every (seconds)",
      "type": "number",
      "default": 8,
      "help": "How often the open Docker tab refreshes status and stats (5 to 120)."
    }
  ]
}
