//==== module ====
{
  "id": "proxmox",
  "name": "Proxmox",
  "description": "Manage Proxmox VE right inside Connect. Adds a \"Proxmox Node\" server type (the Terminal is the node's root shell) with Mgmt and Monitor tabs, start / stop / reboot for VMs and containers, and a built-in live console: a fast native VNC viewer for VMs and a terminal for containers. Uses a Proxmox API token (Datacenter > Permissions > API Tokens); the node's certificate is pinned by fingerprint.",
  "version": "0.3.1",
  "minApi": 6,
  "permissions": [
    "data",
    "net",
    "console"
  ],
  "serverTypes": [
    {
      "id": "pve",
      "label": "Proxmox Node",
      "sshBacked": true,
      "defaultTab": "pve-mgmt"
    }
  ],
  "config": [
    {
      "key": "interval",
      "label": "Refresh every (seconds)",
      "type": "number",
      "default": 5,
      "help": "How often the Mgmt and Monitor pages refresh while open (2 to 60)."
    },
    {
      "key": "confirmStop",
      "label": "Ask before forced stop, reset and delete",
      "type": "checkbox",
      "default": true,
      "help": "Shows a confirmation before actions that can lose data."
    }
  ]
}
