//==== module ====
{
  "id": "coding_agent",
  "name": "Coding agent",
  "description": "A chat page for coding agents. Uses the Claude Code CLI already installed on this computer, so your own Claude subscription does the work: no API key, and nothing is sent anywhere by Connect. Chats persist, tool use asks for your approval, and old chats stay in a history.",
  "version": "0.5.0",
  "minApi": 7,
  "permissions": [
    "spawn",
    "data"
  ],
  "binaries": [
    "claude"
  ],
  "pages": [
    {
      "id": "agent",
      "label": "Coding agent"
    }
  ],
  "config": [
    {
      "key": "mode",
      "label": "Default permissions",
      "type": "select",
      "default": "manual",
      "options": [
        [
          "manual",
          "Ask before editing files or running commands"
        ],
        [
          "acceptEdits",
          "Allow file edits, ask for commands"
        ],
        [
          "plan",
          "Plan only (no changes)"
        ],
        [
          "bypassPermissions",
          "Allow everything (dangerous)"
        ]
      ],
      "help": "Can be changed per chat."
    },
    {
      "key": "model",
      "label": "Default model",
      "type": "select",
      "default": "",
      "options": [
        [
          "",
          "Claude Code default"
        ],
        [
          "sonnet",
          "Sonnet"
        ],
        [
          "opus",
          "Opus"
        ],
        [
          "haiku",
          "Haiku"
        ]
      ]
    },
    {
      "key": "folder",
      "label": "Default folder",
      "type": "text",
      "placeholder": "/home/me/project (empty = your home folder)"
    }
  ]
}
