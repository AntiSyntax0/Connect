{"format": "connect-modules", "v": 1, "modules": [{"file": "proxmox.mod", "name": "Proxmox", "description": "Manage Proxmox VE right inside Connect. Adds a \"Proxmox Node\" server type (the Terminal is the node's root shell) with Mgmt and Monitor tabs, start / stop / reboot for VMs and containers, and a built-in live console: a fast native VNC viewer for VMs and a terminal for containers. Uses a Proxmox API token (Datacenter > Permissions > API Tokens); the node's certificate is pinned by fingerprint.", "version": "0.3.0", "permissions": ["data", "net", "console"], "minApi": 6, "sha256": "9a53316d3d715ec4752e2ba67a4b1b5dba6af801c16684506720cbf005120bf0", "sig": "T/hTUcJrA17Ooh7i4VDs/ZVmJYtLxdwnQS1kA7ZmRRGdtNjc5GEl8N/iEOumi5pnDuZARdVkAcIIVSjf2YWuAg==", "size": 432355}]}