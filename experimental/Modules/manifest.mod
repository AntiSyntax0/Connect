{"format": "connect-modules", "v": 1, "modules": [{"file": "arr.mod", "name": "Arr stack", "description": "A page for the *arr suite: library statistics and health of Sonarr / Radarr / Lidarr / Readarr / Prowlarr, live download status (qBittorrent, SABnzbd and the arr queues), who is logged in and watching on Plex / Jellyfin / Emby, and search + request of movies and shows into Sonarr / Radarr (with optional TMDB metadata). Uses each app's API, directly or through your saved SSH logins, and can detect services and their API keys from Docker over SSH.", "version": "0.2.0", "permissions": ["ssh", "data", "http"], "minApi": 7, "sha256": "ec728a83306433be7b7934752178f7443d769f78eab7f5a09714977d72905abc", "sig": "B4VH0ruH2TxUv/YzezqDD/kZNR3FH83i1NEaXA4l+XsExvVLLwpstr89z2FfhultJmjmQTFcH5AvgBKnAk1UBQ==", "size": 578718}, {"file": "coding_agent.mod", "name": "Coding agent", "description": "A chat page for coding agents. Uses the Claude Code CLI already installed on this computer, so your own Claude subscription does the work: no API key, and nothing is sent anywhere by Connect. Chats persist, tool use asks for your approval, and old chats stay in a history.", "version": "0.5.0", "permissions": ["spawn", "data"], "minApi": 7, "sha256": "dd172bf23304190845fb3f1031a9205a2671fa7ffb2c710026b3604a8f2f304b", "sig": "QOsB+25HlMyfWdhdKcw3Ls6WN0d80W71/HfSxjs1gkMsKYZ/zYALH3rq98tD6rvToVzSdHXNUiuvQY5mXbBVAQ==", "size": 348356}, {"file": "docker.mod", "name": "Docker helper", "description": "A Docker tab for your SSH servers: compose stacks (found by scanning for compose files and docker ps), containers, networks and volumes, live CPU / memory, start / stop / restart, a shell inside a container, a live log tail and a compose file editor. Works over your saved SSH logins through the docker CLI on the server: no socket exposed, nothing to install on the server.", "version": "0.2.0", "permissions": ["ssh", "sshStream", "data"], "minApi": 7, "sha256": "02d9ab0a495064a486b437f7d5f4751ef51b69c88c40877d11c77efd79a4f50d", "sig": "t5/cQCynW5u+OJfKix327nSpobZEd47BJ7cgGTYS+croQwJsP/qjFm1oCWpEk3vU9QWN+syr5B9cpt/9ftz9Cw==", "size": 448438}, {"file": "game.mod", "name": "Game Panel", "description": "Manage game servers on a Pterodactyl-compatible panel (Pterodactyl, Calagopus ...): live status with CPU / RAM / disk, start / stop / restart / kill, sending console commands, and a file manager with a text editor.", "version": "0.2.0", "permissions": ["http"], "minApi": 7, "sha256": "bf92701ddfc7e68dcace1be24c62a765aea2acfe54f7f74ddf15f966ea81ef59", "sig": "i09Vo0zs5/Uq/R2fUNa43lIyqOVxi98W8F+1RWYKfcU5z1O73q0QtY5YKGmaB2wPuTvuCnQRSV33Ngk7eDLWBQ==", "size": 327376}, {"file": "proxmox.mod", "name": "Proxmox", "description": "Manage Proxmox VE right inside Connect. Adds a \"Proxmox Node\" server type (the Terminal is the node's root shell) with Mgmt and Monitor tabs, start / stop / reboot for VMs and containers, and a built-in live console: a fast native VNC viewer for VMs and a terminal for containers. Uses a Proxmox API token (Datacenter > Permissions > API Tokens); the node's certificate is pinned by fingerprint.", "version": "0.3.1", "permissions": ["data", "net", "console"], "minApi": 6, "sha256": "b182a59f4ec4798485ff6eaee5105741be5cc8936483768ee1c5171aa63c9edb", "sig": "5C3ytIQaQmPUitKt3J+uJ/bvXCrmWNGBN3B2qiuw9t1JdHIXa+GYe0si8u+RXy3Ivoua38Vdlksk5Xm9+dPsCw==", "size": 432222}]}