//==== module ====
{
  "id": "game_panel",
  "name": "Game Panel",
  "description": "Manage game servers on a Pterodactyl-compatible panel (Pterodactyl, Calagopus ...): live status with CPU / RAM / disk, start / stop / restart / kill, sending console commands, and a file manager with a text editor.",
  "version": "0.2.0",
  "minApi": 7,
  "permissions": [
    "http"
  ],
  "pages": [
    {
      "id": "game",
      "label": "Game servers"
    }
  ],
  "config": [
    {
      "key": "url",
      "label": "Panel URL",
      "type": "text",
      "placeholder": "https://panel.example.com",
      "help": "Address of your panel, without /api/client."
    },
    {
      "key": "apiKey",
      "label": "Client API key",
      "type": "password",
      "help": "Create one in your panel under Account > API Keys. It needs the server permissions for what you want to do (control.start / stop / restart / console, file.*). It is stored encrypted on this computer."
    }
  ]
}
